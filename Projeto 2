package com.example.finance.controller;

import com.example.finance.model.Transaction;
import com.example.finance.service.AiService;
import com.example.finance.service.AudioService;
import com.example.finance.service.FinanceService;
import jakarta.validation.Valid;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api")
public class FinanceController {

    private final FinanceService financeService;
    private final AiService aiService;
    private final AudioService audioService;

    public FinanceController(
            FinanceService financeService,
            AiService aiService,
            AudioService audioService
    ) {
        this.financeService = financeService;
        this.aiService = aiService;
        this.audioService = audioService;
    }

    // ============================
    // TRANSAÇÕES
    // ============================

    @PostMapping("/transactions")
    public ResponseEntity<Transaction> create(
            @Valid @RequestBody Transaction transaction
    ) {

        return ResponseEntity.ok(
                financeService.create(transaction)
        );
    }

    @GetMapping("/transactions")
    public List<Transaction> findAll() {
        return financeService.findAll();
    }

    @GetMapping("/transactions/{id}")
    public Transaction findById(
            @PathVariable Long id
    ) {
        return financeService.findById(id);
    }

    @PutMapping("/transactions/{id}")
    public Transaction update(
            @PathVariable Long id,
            @Valid @RequestBody Transaction transaction
    ) {
        return financeService.update(id, transaction);
    }

    @DeleteMapping("/transactions/{id}")
    public ResponseEntity<Void> delete(
            @PathVariable Long id
    ) {

        financeService.delete(id);

        return ResponseEntity.noContent().build();
    }

    @GetMapping("/transactions/type/{type}")
    public List<Transaction> findByType(
            @PathVariable String type
    ) {
        return financeService.findByType(type);
    }

    @GetMapping("/transactions/category/{category}")
    public List<Transaction> findByCategory(
            @PathVariable String category
    ) {
        return financeService.findByCategory(category);
    }

    @GetMapping("/transactions/search")
    public List<Transaction> search(
            @RequestParam String description
    ) {
        return financeService.findByDescription(description);
    }

    // ============================
    // FINANCEIRO
    // ============================

    @GetMapping("/finance/balance")
    public Map<String, Object> balance() {

        return Map.of(
                "income", financeService.getTotalIncome(),
                "expenses", financeService.getTotalExpenses(),
                "balance", financeService.getBalance()
        );
    }

    @GetMapping("/finance/summary")
    public String summary() {
        return financeService.getFinancialSummary();
    }

    // ============================
    // INTELIGÊNCIA ARTIFICIAL
    // ============================

    @PostMapping("/assistant/chat")
    public Map<String, String> chat(
            @RequestBody ChatRequest request
    ) {

        String response = aiService.chat(request.message());

        return Map.of(
                "message", request.message(),
                "response", response
        );
    }

    // ============================
    // ÁUDIO
    // ============================

    @PostMapping(
            value = "/assistant/audio",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public Map<String, String> audio(
            @RequestParam("file") MultipartFile file
    ) throws Exception {

        if (file.isEmpty()) {
            throw new IllegalArgumentException(
                    "O arquivo de áudio está vazio."
            );
        }

        String transcription = audioService.transcribe(
                file.getBytes(),
                file.getOriginalFilename() == null
                        ? "audio.mp3"
                        : file.getOriginalFilename()
        );

        String response = aiService.chat(transcription);

        return Map.of(
                "transcription", transcription,
                "response", response
        );
    }

    @PostMapping("/assistant/speech")
    public ResponseEntity<byte[]> speech(
            @RequestBody SpeechRequest request
    ) {

        byte[] audio = audioService.generateSpeech(
                request.text()
        );

        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=\"response.mp3\""
                )
                .contentType(MediaType.parseMediaType("audio/mpeg"))
                .body(audio);
    }

    public record ChatRequest(String message) {
    }

    public record SpeechRequest(String text) {
    }
}
