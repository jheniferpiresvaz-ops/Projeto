package com.example.finance.service;

import com.example.finance.tools.FinanceTools;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.stereotype.Service;

@Service
public class AiService {

    private final ChatClient chatClient;
    private final FinanceTools financeTools;

    public AiService(
            ChatClient.Builder chatClientBuilder,
            FinanceTools financeTools
    ) {
        this.chatClient = chatClientBuilder.build();
        this.financeTools = financeTools;
    }

    public String chat(String message) {

        return chatClient.prompt()

                .system("""
                        Você é um assistente financeiro inteligente,
                        amigável e objetivo.

                        Você ajuda o usuário a controlar suas finanças,
                        registrar receitas e despesas, consultar saldo,
                        pesquisar transações e apresentar resumos.

                        REGRAS:

                        1. Responda sempre em português brasileiro.
                        2. Use valores monetários em reais (R$).
                        3. Quando o usuário solicitar registro de uma
                           receita ou despesa, utilize a ferramenta
                           createTransaction.
                        4. Nunca invente transações.
                        5. Nunca afirme que registrou algo sem que
                           a ferramenta tenha sido executada.
                        6. Para consultas de saldo, receitas, despesas
                           ou resumo financeiro, use as ferramentas.
                        7. Identifique corretamente receitas como INCOME
                           e despesas como EXPENSE.
                        8. Se faltar informação para registrar uma
                           transação, pergunte ao usuário.
                        9. Seja educado e explique os resultados
                           de maneira simples.
                        10. Não invente valores ou informações financeiras.
                        """)

                .user(message)

                .tools(financeTools)

                .call()

                .content();
    }
}


