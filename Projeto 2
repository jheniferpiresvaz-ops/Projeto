package com.example.finance.service;

import com.example.finance.model.Transaction;
import com.example.finance.repository.TransactionRepository;
import org.springframework.stereotype.Service;

import java.math.BigDecimal;
import java.util.List;

@Service
public class FinanceService {

    private final TransactionRepository repository;

    public FinanceService(TransactionRepository repository) {
        this.repository = repository;
    }

    public Transaction create(Transaction transaction) {

        validateTransaction(transaction);

        transaction.setType(transaction.getType().toUpperCase());

        return repository.save(transaction);
    }

    public List<Transaction> findAll() {
        return repository.findAll();
    }

    public Transaction findById(Long id) {
        return repository.findById(id)
                .orElseThrow(() ->
                        new RuntimeException(
                                "Transação não encontrada: " + id
                        )
                );
    }

    public Transaction update(Long id, Transaction transaction) {

        Transaction existing = findById(id);

        validateTransaction(transaction);

        existing.setDescription(transaction.getDescription());
        existing.setAmount(transaction.getAmount());
        existing.setType(transaction.getType().toUpperCase());
        existing.setCategory(transaction.getCategory());
        existing.setDate(transaction.getDate());

        return repository.save(existing);
    }

    public void delete(Long id) {
        Transaction transaction = findById(id);
        repository.delete(transaction);
    }

    public List<Transaction> findByType(String type) {
        return repository.findByTypeIgnoreCase(type);
    }

    public List<Transaction> findByCategory(String category) {
        return repository.findByCategoryIgnoreCase(category);
    }

    public List<Transaction> findByDescription(String description) {
        return repository.findByDescriptionContainingIgnoreCase(
                description
        );
    }

    public BigDecimal getTotalIncome() {

        return repository.findByTypeIgnoreCase("INCOME")
                .stream()
                .map(Transaction::getAmount)
                .reduce(BigDecimal.ZERO, BigDecimal::add);
    }

    public BigDecimal getTotalExpenses() {

        return repository.findByTypeIgnoreCase("EXPENSE")
                .stream()
                .map(Transaction::getAmount)
                .reduce(BigDecimal.ZERO, BigDecimal::add);
    }

    public BigDecimal getBalance() {
        return getTotalIncome().subtract(getTotalExpenses());
    }

    public String getFinancialSummary() {

        BigDecimal income = getTotalIncome();
        BigDecimal expenses = getTotalExpenses();
        BigDecimal balance = getBalance();

        return """
                RESUMO FINANCEIRO

                Total de receitas: R$ %s
                Total de despesas: R$ %s
                Saldo atual: R$ %s
                """.formatted(
                income,
                expenses,
                balance
        );
    }

    private void validateTransaction(Transaction transaction) {

        if (transaction.getDescription() == null
                || transaction.getDescription().isBlank()) {
            throw new IllegalArgumentException(
                    "A descrição é obrigatória."
            );
        }

        if (transaction.getAmount() == null
                || transaction.getAmount().compareTo(BigDecimal.ZERO) <= 0) {
            throw new IllegalArgumentException(
                    "O valor deve ser maior que zero."
            );
        }

        if (transaction.getType() == null
                || transaction.getType().isBlank()) {
            throw new IllegalArgumentException(
                    "O tipo da transação é obrigatório."
            );
        }

        String type = transaction.getType().toUpperCase();

        if (!type.equals("INCOME") && !type.equals("EXPENSE")) {
            throw new IllegalArgumentException(
                    "O tipo deve ser INCOME ou EXPENSE."
            );
        }
    }
}


