package com.example.finance.tools;

import com.example.finance.model.Transaction;
import com.example.finance.service.FinanceService;
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.ai.tool.annotation.ToolParam;
import org.springframework.stereotype.Component;

import java.math.BigDecimal;
import java.time.LocalDate;

@Component
public class FinanceTools {

    private final FinanceService financeService;

    public FinanceTools(FinanceService financeService) {
        this.financeService = financeService;
    }

    @Tool(description = """
            Registra uma nova transação financeira.
            Use INCOME para receita e EXPENSE para despesa.
            """)
    public String createTransaction(
            @ToolParam(description = "Descrição da transação")
            String description,

            @ToolParam(description = "Valor monetário positivo")
            BigDecimal amount,

            @ToolParam(description = "INCOME ou EXPENSE")
            String type,

            @ToolParam(description = "Categoria da transação")
            String category
    ) {

        Transaction transaction = new Transaction(
                description,
                amount,
                type,
                category,
                LocalDate.now()
        );

        Transaction saved = financeService.create(transaction);

        return "Transação registrada com sucesso! "
                + "ID: " + saved.getId()
                + ", descrição: " + saved.getDescription()
                + ", valor: R$ " + saved.getAmount()
                + ", tipo: " + saved.getType()
                + ", categoria: " + saved.getCategory();
    }

    @Tool(description = "Consulta o saldo financeiro atual.")
    public String getBalance() {
        return "Seu saldo atual é R$ "
                + financeService.getBalance();
    }

    @Tool(description = "Consulta o total de receitas.")
    public String getIncome() {
        return "Total de receitas: R$ "
                + financeService.getTotalIncome();
    }

    @Tool(description = "Consulta o total de despesas.")
    public String getExpenses() {
        return "Total de despesas: R$ "
                + financeService.getTotalExpenses();
    }

    @Tool(description = "Apresenta um resumo financeiro completo.")
    public String getFinancialSummary() {
        return financeService.getFinancialSummary();
    }

    @Tool(description = """
            Consulta transações por categoria.
            """)
    public String findByCategory(
            @ToolParam(description = "Categoria desejada")
            String category
    ) {

        var transactions =
                financeService.findByCategory(category);

        if (transactions.isEmpty()) {
            return "Nenhuma transação encontrada na categoria "
                    + category;
        }

        return transactions.toString();
    }

    @Tool(description = """
            Pesquisa transações por parte da descrição.
            """)
    public String searchTransactions(
            @ToolParam(description = "Termo para pesquisa")
            String description
    ) {

        var transactions =
                financeService.findByDescription(description);

        if (transactions.isEmpty()) {
            return "Nenhuma transação encontrada com o termo: "
                    + description;
        }

        return transactions.toString();
    }
}


